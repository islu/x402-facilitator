# ---------------------------------------------------------------------------
# Networks
# ---------------------------------------------------------------------------
# Every network listed here gets its payment schemes registered. Networks use
# CAIP-2 identifiers; the chain ID in the identifier is checked against the RPC
# endpoint at startup.
#
#   eip155:8453     Base mainnet          eip155:84532    Base Sepolia
#   eip155:137      Polygon               eip155:42161    Arbitrum One
#
EVM_RPC_URLS=eip155:84532=https://sepolia.base.org

# Solana networks (optional). Leave empty to run EVM-only.
#   solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp   mainnet
#   solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1   devnet
SVM_RPC_URLS=

# ---------------------------------------------------------------------------
# Settlement wallets
# ---------------------------------------------------------------------------
# These wallets pay gas, so keep them funded — and keep them separate from the
# seller's payTo wallet and from any buyer test wallets.
EVM_PRIVATE_KEY=
SVM_PRIVATE_KEY=

# Per-network overrides. Prefer one wallet per network so a compromised testnet
# key cannot spend mainnet funds.
# EVM_PRIVATE_KEYS=eip155:8453=0x...,eip155:84532=0x...
# SVM_PRIVATE_KEYS=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp=...

# ---------------------------------------------------------------------------
# Protocol
# ---------------------------------------------------------------------------
# Also serve the legacy v1 protocol under its pre-CAIP-2 network names
# (base, base-sepolia, solana, solana-devnet).
ENABLE_V1=true
# EVM_V1_ALIASES=eip155:84532=base-sepolia
# SVM_V1_ALIASES=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1=solana-devnet

# Smart-wallet (ERC-6492) factories this facilitator may call to deploy an
# undeployed wallet during settlement. Empty denies all factory calls — only
# list factories you trust, since a listed factory can be invoked with
# attacker-supplied calldata.
EIP6492_ALLOWED_FACTORIES=

# Re-simulate the transfer during settle. Verify always simulates; enabling this
# costs an extra RPC round trip per settlement.
SIMULATE_IN_SETTLE=false

# ---------------------------------------------------------------------------
# Policy
# ---------------------------------------------------------------------------
# Assets this facilitator settles, as <network>/<asset>=<bounds> in the asset's
# atomic units: "max", "min:max", or ":" for unbounded. USDC has 6 decimals, so
# 1000:10000000 = 0.001–10 USDC. Empty accepts ANY token — and your wallet pays
# gas to settle it — so always set this in production. Each network must also be
# in EVM_RPC_URLS / SVM_RPC_URLS. (Replaces the old MAX_SETTLE_AMOUNT.)
ALLOWED_ASSETS=eip155:84532/0x036CbD53842c5426634e7929541eC2318f3dCF7e=1000:10000000

# Accepted verify+settle calls per payer per minute. Only payments the mechanism
# accepted count, so a forged payload cannot use up someone else's quota. 0
# disables. Enforced per instance, only for payers the payload identifies (EVM).
RATE_LIMIT_PER_MINUTE=0

# All verify+settle calls per caller IP per minute, accepted or not. This is what
# bounds junk traffic. The caller is a resource server, so size it for a whole
# server's traffic. 0 disables.
RATE_LIMIT_PER_IP_PER_MINUTE=600

# Refuse to broadcast above this gas price, in gwei. Empty is uncapped.
MAX_GAS_PRICE_GWEI=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4022
# /metrics is served here only. Let the scraper reach it; keep it off the internet.
ADMIN_PORT=9090
LOG_LEVEL=info
LOG_JSON=true

# Proxy IPs whose X-Forwarded-For may be trusted. Empty trusts none.
TRUSTED_PROXIES=

VERIFY_TIMEOUT=30s
SETTLE_TIMEOUT=90s
RECEIPT_TIMEOUT=60s
SHUTDOWN_TIMEOUT=30s
GAS_LIMIT=300000

# Wallet balance polling. Below the threshold for its chain the facilitator logs
# a warning; the balance is always exported as facilitator_wallet_balance.
BALANCE_CHECK_INTERVAL=5m
MIN_BALANCE_WEI=50000000000000000
MIN_BALANCE_LAMPORTS=50000000
